---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, thumbnailUrl, youtubeLink, instagramLink, facebookLink } = Astro.props;

// Helper to extract YouTube ID
const getYoutubeId = (url?: string) => {
	if (!url) return null;
	const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
	const match = url.match(regExp);
	return (match && match[2].length === 11) ? match[2] : null;
};
const ytId = getYoutubeId(youtubeLink);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-[#fffaf0] text-gray-800 antialiased font-sans">
		<!-- Navigation (Copied from index to keep it consistent) -->
		<nav class="bg-white shadow-sm sticky top-0 z-50">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between h-16 items-center">
					<div class="flex-shrink-0 flex items-center space-x-3">
						<div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center border-2 border-orange-500 overflow-hidden">
							<span class="text-orange-600 font-bold text-lg">E&G</span>
						</div>
						<a href="/" class="text-2xl font-bold text-orange-600 tracking-tight hover:text-orange-700">Ember <span class="text-yellow-500">&</span> Ghee</a>
					</div>
					<div class="hidden md:flex space-x-8">
						<a href="/" class="text-gray-500 hover:text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 border-transparent hover:border-gray-300 text-sm font-medium">Home</a>
						<a href="/blog" class="text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 border-orange-500 text-sm font-medium">Recipes</a>
						<a href="/about" class="text-gray-500 hover:text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 border-transparent hover:border-gray-300 text-sm font-medium">About</a>
					</div>
				</div>
			</div>
		</nav>

		<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<article class="bg-white rounded-3xl shadow-sm p-6 sm:p-10 border border-gray-100">
				
				<!-- Video or Thumbnail -->
				<div class="w-full bg-gray-100 rounded-2xl overflow-hidden mb-8 aspect-video flex items-center justify-center relative">
					{ytId ? (
						<iframe 
							class="w-full h-full absolute top-0 left-0" 
							src={`https://www.youtube.com/embed/${ytId}`} 
							title={title} 
							frameborder="0" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
							allowfullscreen>
						</iframe>
					) : thumbnailUrl ? (
						<img src={thumbnailUrl} alt={title} class="w-full h-full object-cover" />
					) : heroImage ? (
						<img src={heroImage.src} alt={title} class="w-full h-full object-cover" />
					) : (
						<span class="text-gray-400">No media available</span>
					)}
				</div>

				<div class="text-center mb-10">
					<div class="text-gray-500 text-sm font-medium mb-3">
						<FormattedDate date={pubDate} />
					</div>
					<h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mb-6">{title}</h1>
					
					<!-- Social Call to Actions -->
					<div class="flex flex-wrap justify-center gap-4 mt-6">
						<a href={youtubeLink || "https://www.youtube.com/@emberandghee"} target="_blank" class="inline-flex items-center space-x-2 bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2 rounded-full font-semibold transition">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd" /></svg>
							<span>{youtubeLink ? "Watch Video" : "Subscribe"}</span>
						</a>
						
						<a href={instagramLink || "https://www.instagram.com/emberandghee/"} target="_blank" class="inline-flex items-center space-x-2 bg-pink-50 hover:bg-pink-100 text-pink-600 px-4 py-2 rounded-full font-semibold transition">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" /></svg>
							<span>{instagramLink ? "View Reel" : "Follow on Instagram"}</span>
						</a>
						
						<a href={facebookLink || "https://www.facebook.com/emberandghee/"} target="_blank" class="inline-flex items-center space-x-2 bg-blue-50 hover:bg-blue-100 text-blue-600 px-4 py-2 rounded-full font-semibold transition">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" /></svg>
							<span>Follow on Facebook</span>
						</a>
					</div>
				</div>
				
				<!-- Recipe Content -->
				<div class="prose prose-lg prose-orange mx-auto">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
